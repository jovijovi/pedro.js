{
  "name": "@jovijovi/pedro.js",
  "version": "2.0.0",
  "description": "Pedro.js is a microservice toolkit written in TypeScript",
  "author": "jovijovi <mageyul@hotmail.com>",
  "license": "MIT",
  "keywords": [
    "typescript",
    "microservice",
    "toolkit",
    "pedro",
    "pedro.js",
    "tools",
    "crypto",
    "security",
    "cache",
    "log",
    "queue",
    "random",
    "retry",
    "stack",
    "time",
    "event",
    "fsm",
    "module",
    "network",
    "http",
    "jsonrpc",
    "websocket",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jovijovi/pedro.js.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/client-sqs": "^3.1009.0",
    "@grpc/grpc-js": "^1.14.3",
    "@jovijovi/express-2fa-token": "1.1.0",
    "@jovijovi/pedrojs-common": "1.2.1",
    "@jovijovi/pedrojs-event": "1.2.1",
    "@jovijovi/pedrojs-log": "1.2.1",
    "@jovijovi/pedrojs-network": "1.2.2",
    "@jovijovi/pedrojs-tracing": "1.2.1",
    "@jovijovi/pedrojs-types": "1.0.5",
    "@jovijovi/pedrojs-version": "^1.0.12",
    "@jovijovi/two-fa.js": "^0.2.5",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-jaeger": "2.6.0",
    "@opentelemetry/instrumentation-express": "0.61.0",
    "@opentelemetry/instrumentation-http": "0.213.0",
    "@opentelemetry/sdk-trace-base": "2.6.0",
    "@opentelemetry/sdk-trace-node": "2.6.0",
    "@types/body-parser": "1.19.6",
    "@types/express": "5.0.6",
    "@types/jaeger-client": "^3.18.7",
    "@types/level": "^6.0.1",
    "@types/ws": "^8.18.1",
    "body-parser": "^2.2.2",
    "commander": "14.0.3",
    "dayjs": "1.11.20",
    "dgraph-js-http": "^21.3.1",
    "express": "5.2.1",
    "ipfs-http-client": "56.0.3",
    "jaeger-client": "3.19.0",
    "jayson": "4.3.0",
    "level": "^10.0.0",
    "log4js": "^6.9.1",
    "lru-cache": "^11.2.7",
    "mongoose": "^9.3.0",
    "mysql2": "^3.19.1",
    "nanoid": "5.1.6",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "redis": "^5.11.0",
    "sequelize": "^6.37.8",
    "sqlite3": "6.0.1",
    "ws": "^8.19.0",
    "yaml": "^2.8.2"
  },
  "scripts": {
    "test": "jest --coverage --forceExit",
    "clean": "rm -rf ./dist/*",
    "build": "pnpm run clean && tsc -p tsconfig.json && rm -rf ./dist/test && cp -ap conf ./dist",
    "dev-run": "ts-node-esm ./examples/server/index.ts",
    "dist-run": "node ./dist/examples/server/index.js",
    "clean-pub": "rm -rf ./publish/* && mkdir -p ./publish",
    "prepub": "pnpm run clean-pub && pnpm run build && cp -ap ./dist/lib ./publish/lib && cp -ap LICENSE ./publish/ && cp -ap package.json ./publish/ && cp -ap README.md ./publish/"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "jest": "30.3.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.32.1"
}
